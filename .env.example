# Copy to .env and fill in. Without LLM_PROVIDER and LLM_MODEL the generate path is off.
# LLM_PROVIDER is a pydantic-ai provider name: anthropic, openai, google, openrouter, ollama, ...

# Anthropic
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=

# OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5
# LLM_API_KEY=

# Google Gemini
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.5-pro
# LLM_API_KEY=

# OpenRouter (many vendors behind one key)
# LLM_PROVIDER=openrouter
# LLM_MODEL=anthropic/claude-sonnet-5-5
# LLM_API_KEY=

# Any OpenAI-compatible server, e.g. local Ollama
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma4:12b
# LLM_URL=http://localhost:11434/v1
